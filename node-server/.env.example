PORT=3000
HOST=0.0.0.0

# Path to the directory where Drupal writes serialized entity files.
# Default: <repo>/public/serialized (matches the public:// stream wrapper).
EXPORT_DIR=./public/serialized

# Path to the directory where Drupal writes view exports.
# Default: <repo>/public/views
VIEWS_DIR=./public/views

# Path to the alias-buckets directory generated by AliasBucketManager.
# Default: <repo>/public/alias-buckets
ALIAS_DIR=./public/alias-buckets

# Cache-Control max-age (seconds) for entity/view/alias responses.
CACHE_MAX_AGE=3600

# CORS origin (use * for any, or a comma-separated list of allowed origins).
CORS_ORIGIN=*

# Log level (fatal, error, warn, info, debug, trace).
LOG_LEVEL=info
